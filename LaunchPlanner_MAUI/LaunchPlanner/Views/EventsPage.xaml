<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaunchPlanner.Core.ViewModels;assembly=LaunchPlanner.Core"
             xmlns:models="clr-namespace:LaunchPlanner.Core.Models;assembly=LaunchPlanner.Core"
             xmlns:res="clr-namespace:LaunchPlanner.Core.Resources;assembly=LaunchPlanner.Core"
             xmlns:views="clr-namespace:LaunchPlanner.Views"
             x:Class="LaunchPlanner.Views.EventsPage"
             x:Name="EventsRoot"
             x:DataType="vm:EventsViewModel"
             Title="{x:Static res:Strings.Events_Title}">

    <ContentPage.Resources>
        <views:PngToImageSourceConverter x:Key="PngToImage" />
        <Style x:Key="DurationEntry" TargetType="Entry">
            <Setter Property="Keyboard" Value="Numeric" />
            <Setter Property="WidthRequest" Value="56" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="VerticalStackLayout">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="8" Padding="16">
        <ScrollView MaximumHeightRequest="340">
            <VerticalStackLayout Spacing="4">
                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <VerticalStackLayout Style="{StaticResource FieldGroup}">
                        <Label Text="{x:Static res:Strings.Events_Start}" />
                        <HorizontalStackLayout Spacing="4">
                            <DatePicker Date="{Binding StartDate}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_StartDate}" />
                            <Entry Text="{Binding StartTime}" Placeholder="hh:mm:ss" WidthRequest="96" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_StartTime}" />
                            <Button Text="{x:Static res:Strings.Events_Now}" Command="{Binding StartNowCommand}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Now}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Style="{StaticResource FieldGroup}">
                        <Label Text="{x:Static res:Strings.Events_Finish}" />
                        <HorizontalStackLayout Spacing="4">
                            <DatePicker Date="{Binding FinishDate}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_EndDate}" />
                            <Entry Text="{Binding FinishTime}" Placeholder="hh:mm:ss" WidthRequest="96" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_EndTime}" />
                            <Label Text="+" VerticalTextAlignment="Center" />
                            <Entry Text="{Binding NowOffsetValue}" Keyboard="Numeric" WidthRequest="56" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_EndOffsetValue}" />
                            <Picker ItemsSource="{Binding NowOffsetUnits}"
                                    SelectedItem="{Binding SelectedNowOffsetUnit}"
                                    ItemDisplayBinding="{Binding Caption, x:DataType=models:NowOffsetUnit}"
                                    WidthRequest="120"
                                    ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_EndOffsetUnit}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Style="{StaticResource FieldGroup}">
                        <Label Text="{x:Static res:Strings.Events_Duration}" />
                        <Grid ColumnDefinitions="56,56,56,56"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Events_DurationDays_Short}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.Events_DurationHours_Short}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.Events_DurationMinutes_Short}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.Events_DurationSeconds_Short}" HorizontalTextAlignment="Center" />
                            <Entry Grid.Row="1" Grid.Column="0" Text="{Binding DurationDays}" Style="{StaticResource DurationEntry}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_DurationDays}" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding DurationHours}" Style="{StaticResource DurationEntry}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_DurationHours}" />
                            <Entry Grid.Row="1" Grid.Column="2" Text="{Binding DurationMinutes}" Style="{StaticResource DurationEntry}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_DurationMinutes}" />
                            <Entry Grid.Row="1" Grid.Column="3" Text="{Binding DurationSeconds}" Style="{StaticResource DurationEntry}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_DurationSeconds}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Style="{StaticResource FieldGroup}">
                        <Label Text="{x:Static res:Strings.Events_Period}" />
                        <Picker ItemsSource="{Binding Periods}"
                                SelectedItem="{Binding SelectedPeriod}"
                                ItemDisplayBinding="{Binding Caption, x:DataType=models:PeriodOption}"
                                WidthRequest="160"
                                ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Period}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Style="{StaticResource FieldGroup}">
                        <Label Text="{x:Static res:Strings.Events_Enabled}" />
                        <CheckBox IsChecked="{Binding IsEventEnabled}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Enabled}" />
                    </VerticalStackLayout>
                </FlexLayout>

                <FlexLayout Direction="{Binding EventListDirection, Source={x:Reference EventsRoot}}"
                            AlignItems="Stretch">
                    <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Shrink="1" Margin="0,0,8,0" Spacing="0">
                        <Label Text="{x:Static res:Strings.Events_Description}" />
                        <Entry Text="{Binding Description}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Description}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Shrink="1" Margin="0,0,0,0" Spacing="0">
                        <Label Text="{x:Static res:Strings.Events_Url}" />
                        <Entry Text="{Binding Url}" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Url}" />
                    </VerticalStackLayout>
                </FlexLayout>

                <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="0,8,0,0">
                    <Button Text="{x:Static res:Strings.Events_Clear}" Command="{Binding ClearCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Clear}" />
                    <Button Text="{x:Static res:Strings.Events_Add}" Command="{Binding AddCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Add}" />
                    <Button Text="{x:Static res:Strings.Events_Test}" Command="{Binding TestCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Test}" />
                    <Button Text="{x:Static res:Strings.Events_Delete}" Command="{Binding EraseCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Delete}" />
                    <Button Text="{x:Static res:Strings.Events_Save}" Command="{Binding SaveCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Save}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="BackgroundColor" Value="Red" />
                                <Setter Property="TextColor" Value="Yellow" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{x:Static res:Strings.Events_Close}" Command="{Binding CloseCommand}" Margin="0,0,8,8" ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Close}" />
                </FlexLayout>
                <Label Text="{Binding Message}" TextColor="{StaticResource Primary}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsMessageError}" Value="True">
                            <Setter Property="TextColor" Value="Red" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding SelectedRow}"
                        SelectionMode="Single"
                        ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_EventList}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EventRow">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="8,0,0,0">
                    <CheckBox IsChecked="{Binding IsEnabled}"
                              VerticalOptions="Center"
                              ToolTipProperties.Text="{x:Static res:Strings.Events_Tooltip_Enabled}" />
                    <Image Grid.Column="1"
                           Source="{Binding Icon, Converter={StaticResource PngToImage}}"
                           WidthRequest="20"
                           HeightRequest="20"
                           VerticalOptions="Center" />
                    <FlexLayout Grid.Column="2"
                                Padding="0,8,8,8"
                                Direction="{Binding EventListDirection, Source={x:Reference EventsRoot}}"
                                AlignItems="Stretch">
                        <Label FontAttributes="Bold" Margin="0,0,8,2" FlexLayout.Grow="1" FlexLayout.Shrink="1">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Description}" />
                                    <Span Text=" - " />
                                    <Span Text="{Binding Period}" />
                                    <Span Text=" - " />
                                    <Span Text="{x:Static res:Strings.Events_Enabled}" />
                                    <Span Text=": " />
                                    <Span Text="{Binding Enabled}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="12" Margin="0,0,8,2" FlexLayout.Grow="1" FlexLayout.Shrink="1">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Start}" />
                                    <Span Text=" → " />
                                    <Span Text="{Binding Finish}" />
                                    <Span Text="  " />
                                    <Span Text="{x:Static res:Strings.EventRow_Duration}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Duration}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding Url}"
                               FontSize="12"
                               Margin="0,0,8,0"
                               LineBreakMode="TailTruncation"
                               FlexLayout.Grow="1"
                               FlexLayout.Shrink="1" />
                    </FlexLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
